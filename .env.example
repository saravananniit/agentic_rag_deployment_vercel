# Astra DB (server side only; set these as Vercel environment variables too)
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...

# Collections shown in Storage (the legacy collection is included when set)
ASTRA_COLLECTIONS=hr_docs,it_docs,fin_docs
# Optional legacy single-collection name; keeps existing kb_docs data visible
ASTRA_KB_COLLECTION=kb_docs
ASTRA_REGISTRY_COLLECTION=doc_registry
ASTRA_TICKETS_COLLECTION=tickets
MAX_UPLOAD_MB=4

# NOTE: Azure OpenAI endpoint / deployment / key are NOT configured here.
# They are typed into the UI at run time and sent per request.
